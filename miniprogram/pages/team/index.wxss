.heading { margin:18rpx 0 16rpx; }.description { margin:20rpx 0 30rpx; }.team-illustration { height:280rpx; position:relative; margin-top:20rpx; }.orbit { position:absolute; width:220rpx; height:220rpx; left:50%; top:26rpx; margin-left:-110rpx; background:#E5E9D5; border-radius:50%; }.buddy-one,.buddy-two { position:absolute; width:118rpx; height:118rpx; font-size:46rpx; border:8rpx solid #F6F5F0; border-radius:36rpx; top:72rpx; }.buddy-one { left:calc(50% - 100rpx); transform:rotate(-10deg); background:#EAB99E; color:#9B4C2D; z-index:2; }.buddy-two { left:calc(50% - 5rpx); top:92rpx; transform:rotate(10deg); background:#C8D3AA; color:#718358; }.spark { position:absolute; left:calc(50% + 94rpx); top:20rpx; color:#CE6036; font-size:48rpx; }.tips { background:#FFFDF7; border-color:#E9E7D9; color:#91947E; font-size:25rpx; padding:26rpx 34rpx; }.tips view + view { margin-top:16rpx; }.actions { margin-top:30rpx; }.form { margin-top:28rpx; }.form .input { margin-top:22rpx; font-size:25rpx; }.form button { margin-top:24rpx; }.form .row > .muted { font-size:40rpx; }.code-input { letter-spacing:1rpx; }.team-hero { margin-top:34rpx; border-radius:32rpx; padding:32rpx; background:#E5EBD8; border:2rpx solid #DCE3CA; }.team-hero .badge { background:rgba(255,255,255,.55); }.team-name { font-size:41rpx; font-weight:800; color:#4C5F3C; margin:22rpx 0 14rpx; word-break:break-all; }.team-count { font-size:92rpx; line-height:1.2; font-weight:850; margin-top:24rpx; color:#4C5F3C; }.team-count text { font-size:26rpx; color:#889678; font-weight:500; }.team-hero .divider { background:#D0D9BD; }.invite-label { font-size:20rpx; color:#81906D; word-break:break-all; }.invite-label text { font-size:23rpx; font-weight:700; color:#566B43; margin-left:10rpx; letter-spacing:2rpx; }.team-hero button { margin-top:22rpx; }.member { padding:26rpx; margin-bottom:18rpx; }.member-info { margin-left:18rpx; max-width:430rpx; }.member-info .tiny { overflow:hidden; white-space:nowrap; text-overflow:ellipsis; max-width:430rpx; font-size:21rpx; }.member-name { font-size:27rpx; font-weight:650; margin-bottom:5rpx; }.self { font-size:17rpx; padding:2rpx 8rpx; color:#A28D6E; background:#F3EBDD; border-radius:8rpx; margin-left:5rpx; }.member-done { font-size:36rpx; color:#7F965F; }.member-bottom { margin-top:22rpx; padding-top:18rpx; border-top:2rpx solid #F0F1E8; }.member-bottom .caption { font-size:21rpx; }.leave { margin:24rpx auto 0; color:#9B9E91; }.nudge-note { font-size:20rpx; margin:22rpx 0; }

.member-detail { width:100%; border-top:2rpx solid #EFEFE7; margin-top:20rpx; padding-top:20rpx !important; font-size:22rpx !important; }.member-entry { min-height:88rpx; }
