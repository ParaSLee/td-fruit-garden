.share-heading { margin:24rpx 0 34rpx; }.share-heading .title { font-size:43rpx; margin:16rpx 0; }.share-heading .eyebrow { font-size:17rpx; letter-spacing:2rpx; }.share-heading .caption { font-size:22rpx; }.share-card { background:#F2E9D3; border:2rpx solid #E4D7B8; border-radius:32rpx; padding:32rpx; overflow:hidden; }.share-card .brand-mark { width:50rpx; height:50rpx; border-radius:16rpx; font-size:28rpx; }.share-brand { margin-left:15rpx; font-size:25rpx; font-weight:800; line-height:1.3; }.share-brand .eyebrow { font-size:12rpx; letter-spacing:2rpx; }.card-edition { border:2rpx solid #DCCBA5; color:#AD946D; border-radius:8rpx; padding:5rpx 12rpx; font-size:19rpx; transform:rotate(7deg); }.share-owner { color:#9A8B6E; font-size:23rpx; margin:42rpx 0 14rpx; }.share-goal { font-size:36rpx; font-weight:750; line-height:1.5; word-break:break-all; }.share-big { font-size:122rpx; font-weight:850; line-height:1.4; color:#D15B34; letter-spacing:-5rpx; }.share-big text { font-size:27rpx; color:#A09171; font-weight:500; letter-spacing:0; }.share-card .caption { font-size:20rpx; color:#A3977C; }.share-card .progress-track { height:12rpx; margin-top:20rpx; background:#DED3B9; }.share-metrics { display:flex; margin:34rpx 0; }.share-metrics > view { flex:1; text-align:center; font-size:19rpx; color:#A0957A; }.share-metrics text { font-size:37rpx; color:#6D7258; font-weight:750; display:block; margin-bottom:4rpx; }.share-metrics > view + view { border-left:2rpx solid #DFD4B9; }.share-week { display:flex; justify-content:space-between; margin-bottom:36rpx; }.share-day { width:58rpx; height:58rpx; border:2rpx dashed #D9CFB5; border-radius:16rpx; color:#BAAF94; text-align:center; line-height:54rpx; font-size:24rpx; }.share-day.done { background:#8C9A72; color:#FFF; border:0; }.share-card-footer { padding-top:20rpx; border-top:2rpx dashed #D5C8AA; color:#9E8764; font-size:22rpx; display:flex; align-items:center; justify-content:space-between; }.share-card-footer text { font-size:12rpx; letter-spacing:2rpx; }.photo-setting { margin-top:26rpx; padding:24rpx; }.photo-label { font-size:26rpx; }.photo-setting .tiny { font-size:19rpx; margin-top:5rpx; }.photo-setting switch { transform:scale(.8); transform-origin:right; }.share-tip { text-align:center; color:#939780; font-size:21rpx; margin-top:24rpx; line-height:1.8; }.evidence { margin-top:18rpx; padding:24rpx; }.evidence .photos { margin-top:14rpx; }.invite-hero { margin:24rpx 0 42rpx; }.invite-hero .brand-mark { height:110rpx; width:110rpx; font-size:66rpx; border-radius:32rpx; margin-bottom:30rpx; }.invite-hero .title { font-size:43rpx; margin:20rpx 0; }.team-invite .title { font-size:38rpx; margin:24rpx 0; word-break:break-all; }
