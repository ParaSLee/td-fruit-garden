<view class="page"><mode-banner /><view class="eyebrow">BETTER TOGETHER</view><view class="title heading">有搭子，更有劲。</view><view class="caption">你往前一步，我也跟上一步。</view><state-panel loading="{{loading}}" error="{{loadError}}" bind:retry="refresh" />
<block wx:if="{{!loading && !loadError}}"><block wx:if="{{!team}}"><view class="team-illustration"><view class="orbit"></view><view class="avatar buddy-one">你</view><view class="avatar buddy-two">＋</view><view class="spark">✦</view><view class="dashed-line"></view></view><view class="center"><view class="section-title">组个队，把坚持变成默契。</view><view class="caption description">各自选目标，一起看见彼此的进步。<br/>有点想偷懒时，就让搭子拉你一把。</view></view><view class="card tips"><view>↗ 看见彼此的今日状态</view><view>♧ 邀请朋友，最多 20 人一队</view><view>✓ 每天一条提醒，温柔督促</view></view>
<view wx:if="{{!form}}" class="stack actions"><button class="primary create-team" bindtap="showCreate">创建我的小队 ↗</button><button class="outline join-team" bindtap="showJoin">我有邀请码，加入小队</button></view>
<view wx:else class="card form"><view class="row"><text class="section-title">{{form === 'create' ? '给小队起个名字' : '输入小队邀请码'}}</text><text class="muted" bindtap="cancelForm">×</text></view><block wx:if="{{form === 'create'}}"><input class="input" placeholder="例如：猛男不鸽队" maxlength="20" value="{{name}}" bindinput="typeName" /><input class="input" placeholder="小队宣言，选填" maxlength="40" value="{{motto}}" bindinput="typeMotto" /></block><input wx:else class="input code-input" placeholder="输入好友发给你的邀请码" maxlength="32" value="{{code}}" bindinput="typeCode" /><view wx:if="{{formError}}" class="error">{{formError}}</view><button class="primary" bindtap="submit" loading="{{saving}}" disabled="{{saving}}">{{form === 'create' ? '就叫这个，创建小队' : '加入小队'}}</button></view></block>
<block wx:else><view class="team-hero"><view class="row"><text class="badge">我的行动搭子</text><text class="tiny muted">{{team.members.length}} / {{team.maxMembers}} 人</text></view><view class="team-name">{{team.name}}</view><view class="caption">{{team.motto}}</view><view class="team-count">{{team.checkedToday}}<text> / {{team.members.length}} 位</text></view><view class="caption">今天已完成打卡</view><view class="divider"></view><view class="row"><view class="invite-label" bindtap="copyCode">邀请码 <text>{{team.inviteCode}}</text> ⧉</view></view><button class="dark" open-type="share">邀请搭子加入 ↗</button></view>
<view class="section"><view class="section-head"><text class="section-title">小队进行时</text><text class="tiny muted">只和自己比进步</text></view><view wx:for="{{team.members}}" wx:key="id" class="card member"><view class="row"><view class="flex"><view class="avatar">{{item.initial}}</view><view class="member-info"><view class="member-name">{{item.nickname}} <text class="self" wx:if="{{item.isSelf}}">我</text><text class="self" wx:if="{{item.captain}}">队长</text></view><view class="tiny muted">{{item.goal ? item.goal.categoryInfo.name + ' · ' + item.goal.title : '正在酝酿新目标'}}</view></view></view><text wx:if="{{item.summary && item.summary.todayDone}}" class="member-done">✓</text></view><view class="member-bottom row"><text class="caption">{{item.summary ? '连续 ' + item.summary.streak + ' 天 · 累计 ' + item.summary.count + ' 天' : '等 TA 开启挑战'}}</text><text wx:if="{{item.summary && item.summary.todayDone}}" class="badge">今日完成</text><button wx:elif="{{!item.isSelf && item.goal && !item.summary.finished}}" class="small outline" data-id="{{item.id}}" bindtap="nudge" disabled="{{item.nudgedToday}}">{{item.nudgedToday ? '已提醒' : '提醒一下 ↗'}}</button><text wx:elif="{{item.isSelf}}" class="tiny muted">今天也要加油</text></view></view></view><view class="tiny muted center nudge-note">提醒会显示在对方的小程序内，每人每天一次。</view><button class="link leave" bindtap="leave">退出小队</button></block></block></view>
