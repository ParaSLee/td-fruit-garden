.heading { font-size:45rpx; margin:20rpx 0; }.goal-summary { margin-top:32rpx; padding:26rpx; }.goal-name { font-size:29rpx; font-weight:700; word-break:break-all; }.optional { font-size:21rpx; font-weight:400; color:#9C9F90; margin-left:10rpx; }.photo-grid { display:flex; flex-wrap:wrap; margin:-6rpx; }.photo-container { position:relative; }.photo { width:198rpx; height:198rpx; margin:6rpx; }.remove-photo { position:absolute; top:12rpx; right:12rpx; width:38rpx; height:38rpx; line-height:34rpx; text-align:center; font-size:30rpx; background:rgba(30,35,26,.7); color:white; border-radius:50%; }.add-photo { width:198rpx; height:198rpx; margin:6rpx; border:2rpx dashed #CFD5C3; border-radius:20rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; font-size:23rpx; color:#979F89; background:#EDF0E5; }.plus { font-size:58rpx; line-height:1.2; font-weight:200; }.text-right { text-align:right; }.honesty { font-size:22rpx; background:#E9EFDC; border-radius:18rpx; padding:20rpx; color:#7C8C64; margin-top:24rpx; }.success { text-align:center; padding-top:55rpx; }.success-stamp { height:180rpx; width:180rpx; margin:0 auto 40rpx; background:#DCE6C8; color:#718758; border-radius:54rpx; transform:rotate(-7deg); font-size:100rpx; line-height:175rpx; box-shadow:10rpx 12rpx 0 #E8ECDC; }.success .title { margin:18rpx 0 24rpx; }.success-goal { margin:40rpx 0; font-size:29rpx; font-weight:600; }.success .outline { margin-top:20rpx; }
