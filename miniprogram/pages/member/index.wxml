<view class="subpage"><state-panel loading="{{loading}}" error="{{loadError}}" bind:retry="refresh" />
<block wx:if="{{!loading && !loadError}}">
  <view class="member-heading"><user-avatar user="{{owner}}" /><view><view class="eyebrow">BETTER TOGETHER</view><view class="member-title">{{owner.nickname}} 的战绩</view></view></view>
  <view class="caption">看见每一天的坚持，为搭子加把劲。</view>
  <view wx:if="{{!goal}}" class="card center empty"><view class="empty-icon">▥</view><view class="section-title">TA 的第一步，值得期待</view><view class="caption empty-description">开始挑战后，进度会出现在这里。</view></view>
  <block wx:else>
    <picker range="{{goalLabels}}" bindchange="chooseGoal" class="goal-picker"><view class="row"><view><text class="badge">{{goal.categoryInfo.name}}</text><view class="selected-goal">{{goal.title}}</view><view class="tiny muted">{{goal.status === 'archived' ? '已结束' : summary.finished ? '周期已结束' : '进行中'}} · 切换挑战</view></view><text>⌄</text></view></picker>
    <button wx:if="{{next}}" class="link" bindtap="moreGoals" loading="{{loadingMore}}" disabled="{{loadingMore}}">加载更早的挑战</button><view wx:if="{{moreError}}" class="error">{{moreError}}，请重试加载</view>
    <view class="stats-hero"><view class="eyebrow">THIS CHALLENGE</view><view class="count">{{summary.count}}<text> / {{goal.days}} 天</text></view><view class="row caption"><text>挑战进度</text><text>{{summary.progress}}%</text></view><view class="progress-track"><view class="progress-fill" style="width:{{summary.progress}}%"></view></view></view>
    <view class="card metrics"><view class="metric"><view class="metric-value">{{summary.streak}}<text class="unit">天</text></view><view class="metric-label">当前连续</view></view><view class="metric"><view class="metric-value">{{summary.best}}<text class="unit">天</text></view><view class="metric-label">最长连续</view></view><view class="metric"><view class="metric-value">{{summary.rate}}<text class="unit">%</text></view><view class="metric-label">已过天数完成率</view></view></view>
    <view class="section"><view class="section-head"><view class="section-title">挑战日历</view><text class="tiny muted">{{goal.startDate}} 起 · {{goal.days}} 天</text></view><view class="card calendar"><view class="calendar-grid"><view wx:for="{{summary.calendar}}" wx:key="date" class="calendar-cell {{item.done ? 'complete' : ''}} {{item.future ? 'future' : ''}} {{item.today ? 'is-today' : ''}}" aria-label="{{item.date}} {{item.done ? '已完成' : item.future ? '未到日期' : '未打卡'}}"><view>{{item.done ? '✓' : item.day}}</view><text>{{item.label}}</text></view></view><view class="calendar-legend"><text class="legend-dot"></text> 已完成 <text class="legend-dot pending"></text> 未打卡 <text class="legend-dot future-dot"></text> 未到日期</view></view></view>
    <view class="insight"><view class="insight-heading">↗ 最近七天</view><view>完成 {{summary.weekDone}} / {{summary.weekEligible}} 天 · {{summary.weekRate}}%</view><view class="tiny">按已开始的挑战日期计算。</view></view>
    <view class="section"><view class="section-head"><view class="section-title">打卡日期</view><text class="caption">{{records.length}} 天</text></view><view wx:if="{{!records.length}}" class="card caption center">等待 TA 的第一条打卡记录。</view><view wx:for="{{records}}" wx:key="date" class="card record row"><text>{{item.date}}</text><text class="badge">✓ 已完成</text></view></view>
  </block>
  <view class="field-hint center privacy-hint">仅当前小队成员可查看。个人感想和打卡照片保持私有。</view>
</block></view>
