<view class="page"><mode-banner /><state-panel loading="{{loading}}" error="{{loadError}}" bind:retry="refresh" /><block wx:if="{{!loading && !loadError}}">
<view class="profile-top"><view class="profile-avatar"><user-avatar user="{{user}}" large /></view><view><view class="profile-name">{{user.nickname}}</view><view class="caption">在自己的节奏里，慢慢变强。</view><text class="edit-link" bindtap="editNickname">{{editing ? '收起设置' : '设置头像与昵称 ↗'}}</text></view></view>
<form wx:if="{{editing}}" bindsubmit="saveNickname"><view class="card profile-form">
  <view class="section-title">让搭子认出你</view>
  <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" binderror="avatarError" disabled="{{saving}}"><user-avatar user="{{avatarDraft}}" large /><view>选择头像 ↗</view></button>
  <button wx:if="{{avatarDraft.avatarUrl}}" class="link" bindtap="removeAvatar" disabled="{{saving}}">使用默认头像</button>
  <view class="field-label">昵称</view><input class="input" name="nickname" type="nickname" maxlength="16" value="{{nickname}}" bindinput="typeNickname" bindblur="typeNickname" bindnicknamereview="reviewNickname" placeholder="填写昵称或选择微信昵称" disabled="{{saving}}" />
  <view class="field-hint">点击输入框可选择微信昵称，也可以自定义。</view>
  <view class="field-hint profile-disclosure">保存后，头像和昵称会展示给小队成员、监督搭子及分享卡访问者。</view>
  <view wx:if="{{formError}}" class="error">{{formError}}</view><button class="primary" form-type="submit" disabled="{{saving}}" loading="{{saving}}">保存个人资料</button>
</view></form>
<view class="identity"><view class="row"><view class="eyebrow">YOUR IDENTITY</view><view class="badge">{{cloud ? '已连接云端' : '本机体验'}}</view></view><view class="identity-title">行动派，从今天算起。</view><view class="caption">不立完美人设，只积攒真实行动。</view></view>
<view class="section"><view class="section-head"><text class="section-title">当前挑战</text><text class="caption" bindtap="showStats">全部战绩 ↗</text></view><view class="card"><block wx:if="{{goal}}"><view class="current-title">{{goal.title}}</view><view class="caption current-meta">{{goal.categoryInfo.name}} · {{goal.days}} 天 · 已完成 {{summary.count}} 天</view><view class="progress-track"><view class="progress-fill" style="width:{{summary.progress}}%"></view></view><button class="link archive" bindtap="finishGoal">{{summary.finished ? '结束并归档这个挑战' : '提前结束这个挑战'}}</button></block><view wx:else class="caption">还没有进行中的目标，去“今日”开启挑战。</view></view></view>
<view class="section"><view class="section-head"><text class="section-title">我在督促的搭子</text><text class="tiny muted">已显示 {{watching.length}} 个目标</text></view><view wx:if="{{!watching.length}}" class="card caption center">打开好友的“督促邀请”，就能加入监督。</view><view wx:for="{{watching}}" wx:key="id" class="card watch-card"><view class="row"><view class="flex"><user-avatar user="{{item.owner}}" /><view class="watch-info"><view>{{item.owner.nickname}}</view><view class="tiny muted">{{item.goal.title}}</view></view></view><text class="badge" wx:if="{{item.summary.todayDone}}">今日完成</text></view><view class="row watch-bottom"><text class="caption">已完成 {{item.summary.count}} / {{item.goal.days}} 天</text><button class="small outline" bindtap="nudge" data-id="{{item.id}}" disabled="{{item.nudgedToday || item.summary.finished || item.summary.todayDone}}">{{item.summary.finished ? '挑战结束' : item.nudgedToday ? '今天已提醒' : item.summary.todayDone ? '明天继续' : '提醒 TA ↗'}}</button></view><text class="remove-link" bindtap="removeWatch" data-id="{{item.id}}">不再监督</text></view><button wx:if="{{watchingNext}}" class="link" bindtap="loadMoreWatches" data-side="watching" loading="{{loadingWatches === 'watching'}}" disabled="{{!!loadingWatches}}">查看更多督促目标</button><view wx:if="{{watchesError && watchesErrorSide === 'watching'}}" class="error">{{watchesError}}，请点击查看更多重试</view><view class="field-hint">提醒显示在对方小程序内，不会自动发送微信消息。</view></view>
<view class="section"><view class="section-head"><text class="section-title">我的监督搭子</text><text wx:if="{{goal}}" class="caption" bindtap="inviteSupervisor">邀请好友 ↗</text></view><view wx:if="{{!watchers.length}}" class="card caption center">有人看见你的坚持，就多了一份动力。</view><view wx:for="{{watchers}}" wx:key="id" class="card watcher row"><view class="flex"><user-avatar user="{{item.user}}" /><text>{{item.user.nickname}}</text></view><text class="remove-link" bindtap="removeWatch" data-id="{{item.id}}">解除监督</text></view><button wx:if="{{watchersNext}}" class="link" bindtap="loadMoreWatches" data-side="watchers" loading="{{loadingWatches === 'watchers'}}" disabled="{{!!loadingWatches}}">查看更多监督搭子</button><view wx:if="{{watchesError && watchesErrorSide === 'watchers'}}" class="error">{{watchesError}}，请点击查看更多重试</view></view>
<view class="section" wx:if="{{nudges.length}}"><view class="section-head"><text class="section-title">收到的提醒</text><text class="caption" bindtap="readNudges">全部已读</text></view><view wx:for="{{nudges}}" wx:key="id" class="card message"><view class="row"><text class="message-name">{{item.senderName}}</text><text class="tiny muted">{{item.date}} {{item.read ? '· 已读' : '· 新'}}</text></view><view>{{item.text}}</view></view></view><view class="card about-row row" bindtap="showPrivacy"><text>关于猛男打卡与隐私说明</text><text class="muted">↗</text></view><view class="version">猛男打卡 v0.1.1 · 每一步，都算数。</view></block></view>
