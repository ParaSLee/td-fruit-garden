<view class="subpage"><mode-banner /><state-panel loading="{{loading}}" error="{{loadError}}" bind:retry="refresh" />
<block wx:if="{{!loading && !loadError && !saved}}"><view class="eyebrow">SHOWING UP IS A WIN</view><view class="title heading">{{editing ? '今天的努力，补充一下。' : '今天的你，做到了。'}}</view><view class="caption">真实记录这一刻，让每一份努力有迹可循。</view><view class="card goal-summary"><view class="flex"><view class="icon-box" style="color:{{goal.categoryInfo.color}}">{{goal.categoryInfo.icon}}</view><view><view class="caption">{{goal.categoryInfo.name}} · {{today}}</view><view class="goal-name">{{goal.title}}</view></view></view></view>
<view class="field-label">给今天留张照片 <text class="optional">选填</text></view><view class="photo-grid"><view wx:for="{{photos}}" wx:key="url" class="photo-container"><image class="photo" src="{{item.url}}" mode="aspectFill" data-index="{{index}}" bindtap="previewPhoto" /><view class="remove-photo" data-index="{{index}}" bindtap="removePhoto">×</view></view><view class="add-photo" wx:if="{{photos.length < 3}}" bindtap="addPhoto"><view class="plus">+</view><view>{{adding ? '正在准备…' : '添加图片'}}</view></view></view><view class="field-hint">最多 3 张，每张不超过 5 MB；照片默认仅自己可见。</view>
<view class="field-label">一句话，记录今天 <text class="optional">选填</text></view><textarea class="input" maxlength="200" value="{{note}}" placeholder="今天的状态如何？给坚持的自己留句话。" bindinput="typeNote" /><view class="field-hint text-right">{{note.length}}/200</view><view class="honesty">✓ 我已完成今天的目标，打卡内容真实。</view><view wx:if="{{formError}}" class="error">{{formError}}</view><button class="primary bottom-action submit-checkin" bindtap="save" loading="{{saving}}" disabled="{{saving || adding}}">{{saving ? '正在保存这份努力…' : editing ? '保存今日记录' : '确认完成，打卡！'}} ↗</button><view class="field-hint center">北京时间当天内可补充内容，不重复计算天数。</view></block>
<view wx:if="{{saved}}" class="success"><view class="success-stamp">✓</view><view class="eyebrow">PROMISE KEPT.</view><view class="title">说到，就做到。</view><view class="caption">今天的努力已存档。<br/>给自己一个肯定，明天继续。</view><view class="card success-goal">{{goal.title}}<view class="tiny muted">{{today}} · 今日已完成</view></view><button class="primary" bindtap="share">分享我的进步 ↗</button><button class="outline" bindtap="goToday">回到今日</button></view></view>
