:host { display:inline-block; flex-shrink:0; vertical-align:middle; }
.avatar { width:70rpx; height:70rpx; border-radius:24rpx; overflow:hidden; background:#F2E6D7; color:#AF673C; display:flex; align-items:center; justify-content:center; font-size:28rpx; font-weight:800; }
.avatar.large { width:138rpx; height:138rpx; border-radius:42rpx; font-size:68rpx; background:#D75A32; color:#FFF1E0; }
image { width:100%; height:100%; display:block; }
