.profile-top { display:flex; align-items:center; padding:18rpx 0 34rpx; }.profile-avatar { width:138rpx; height:138rpx; background:#D75A32; color:#FFF1E0; font-size:68rpx; font-weight:800; border-radius:42rpx; margin-right:28rpx; display:flex; align-items:center; justify-content:center; transform:rotate(-6deg); }.profile-name { font-size:37rpx; font-weight:800; margin-bottom:8rpx; }.profile-top .caption { font-size:22rpx; }.edit-link { font-size:22rpx; color:#AD7857; display:block; margin-top:10rpx; }.identity { background:#E8ECD9; padding:28rpx; border-radius:28rpx; }.identity-title { font-size:33rpx; font-weight:750; margin:22rpx 0 10rpx; color:#576746; }.identity .caption { font-size:23rpx; color:#8B9678; }.nickname-form { display:flex; align-items:center; padding:20rpx; margin-bottom:24rpx; }.nickname-form .input { flex:1; margin-right:16rpx; }.current-title { font-size:29rpx; font-weight:650; word-break:break-all; }.current-meta { margin:12rpx 0 24rpx; font-size:22rpx; }.archive { margin:12rpx 0 -14rpx; font-size:22rpx; color:#A59B84; }.watch-card { padding:26rpx; margin-bottom:18rpx; }.watch-info { margin-left:18rpx; font-size:27rpx; max-width:350rpx; }.watch-info .tiny { max-width:350rpx; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; font-size:21rpx; }.watch-bottom { margin-top:22rpx; }.watch-bottom .caption { font-size:22rpx; }.remove-link { font-size:21rpx; color:#A6A18B; display:block; margin-top:14rpx; }.watcher { padding:22rpx; margin-bottom:16rpx; font-size:26rpx; }.watcher .avatar { margin-right:20rpx; width:60rpx; height:60rpx; }.watcher .remove-link { margin:0; }.message { padding:23rpx; font-size:24rpx; margin-bottom:16rpx; }.message-name { color:#B9774D; font-size:22rpx; font-weight:650; }.message .row { margin-bottom:10rpx; }.about-row { margin-top:36rpx; padding:26rpx; font-size:25rpx; }.version { margin-top:32rpx; text-align:center; font-size:20rpx; color:#A9AD9D; }
