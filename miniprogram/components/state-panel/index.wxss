.state { padding:60rpx 28rpx; text-align:center; color:#8A8E80; font-size:24rpx; }.retry { border-radius:18rpx; background:#E8ECDE; color:#536245; font-size:26rpx; margin-top:26rpx; }.retry::after { border:0; }.error-text { color:#AC573B; }.spinner { width:36rpx; height:36rpx; border:4rpx solid #E5E7DB; border-top-color:#D75A32; border-radius:50%; margin:0 auto 22rpx; animation:spin 1s linear infinite; }@keyframes spin { to { transform:rotate(360deg); } }
