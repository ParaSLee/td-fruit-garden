<view class="page"><mode-banner /><view class="eyebrow">SMALL STEPS. REAL PROGRESS.</view><view class="row heading"><view class="title">努力，都有回响。</view><text class="chart-star">✦</text></view><view class="caption">和过去的自己比，每一步都算数。</view><state-panel loading="{{loading}}" error="{{loadError}}" bind:retry="refresh" />
<block wx:if="{{!loading && !loadError}}"><view wx:if="{{!goal}}" class="card center empty"><view class="empty-icon">▥</view><view class="section-title">这里，会记录你的改变</view><view class="caption empty-description">创建一个目标，完成第一次打卡，<br/>进步就从这一格开始。</view><button class="primary" bindtap="createGoal">开启第一个挑战 ↗</button></view>
<block wx:else><picker range="{{goalLabels}}" bindchange="chooseGoal" class="goal-picker"><view class="row"><view><text class="badge">{{goal.categoryInfo.name}}</text><view class="selected-goal">{{goal.title}}</view></view><text>⌄</text></view></picker><button wx:if="{{next}}" class="link" bindtap="moreGoals" loading="{{loadingMore}}">加载更早的挑战</button>
<view class="stats-hero"><view class="eyebrow">THIS CHALLENGE</view><view class="count">{{summary.count}}<text> / {{goal.days}} 天</text></view><view class="row caption"><text>每个亮起的日子，都有你的努力。</text><text>{{summary.progress}}%</text></view><view class="progress-track"><view class="progress-fill" style="width:{{summary.progress}}%"></view></view></view>
<view class="card metrics"><view class="metric"><view class="metric-value">{{summary.streak}}<text class="unit">天</text></view><view class="metric-label">当前连续</view></view><view class="metric"><view class="metric-value">{{summary.best}}<text class="unit">天</text></view><view class="metric-label">最长连续</view></view><view class="metric"><view class="metric-value">{{summary.rate}}<text class="unit">%</text></view><view class="metric-label">已过天数完成率</view></view></view>
<view class="section"><view class="section-head"><view class="section-title">挑战日历</view><text class="tiny muted">{{goal.startDate}} 起 · {{goal.days}} 天</text></view><view class="card calendar"><view class="calendar-grid"><view wx:for="{{summary.calendar}}" wx:key="date" class="calendar-cell {{item.done ? 'complete' : ''}} {{item.future ? 'future' : ''}} {{item.today ? 'is-today' : ''}}" aria-label="{{item.date}} {{item.done ? '已完成' : item.future ? '尚未开始' : '未打卡'}}"><view>{{item.done ? '✓' : item.day}}</view><text>{{item.label}}</text></view></view><view class="calendar-legend"><text class="legend-dot"></text> 已完成 <text class="legend-dot pending"></text> 未打卡 <text class="legend-dot future-dot"></text> 未到日期</view></view></view>
<view class="insight"><view class="insight-heading">↗ 你的进步观察</view><view>{{summary.insight}}</view><view class="tiny">最近 7 天：{{summary.weekDone}} / {{summary.weekEligible}} 天 · {{summary.weekRate}}%<br/>按已开始的目标日期计算，不计未来天数。</view></view>
<view class="section"><view class="section-head"><text class="section-title">行动档案</text><text class="caption">{{records.length}} 条真实记录</text></view><view wx:if="{{!records.length}}" class="card center caption">等待你的第一条打卡记录。</view><view wx:for="{{records}}" wx:key="id" class="card record"><view class="row"><view class="record-date">{{item.date}}</view><text class="badge">✓ 已完成</text></view><view class="tiny muted">首次打卡 {{item.timeLabel}}</view><view wx:if="{{item.note}}" class="record-note">{{item.note}}</view><view wx:if="{{item.photos.length}}" class="photos"><image wx:for="{{item.photos}}" wx:for-item="photo" wx:key="*this" class="photo" src="{{photo}}" mode="aspectFill" data-url="{{photo}}" data-urls="{{item.photos}}" bindtap="previewPhoto" /></view><view wx:if="{{!item.note && !item.photos.length}}" class="record-note muted">今天，说到做到。</view></view></view></block></block></view>
