.heading { margin:14rpx 0; }.heading .title { font-size:46rpx; }.chart-star { color:#CE5933; font-size:55rpx; }.empty { margin-top:38rpx; padding:38rpx; }.empty-description { margin:18rpx 0 35rpx; }.goal-picker { margin:32rpx 0 24rpx; border-bottom:2rpx solid #E0E4D6; padding-bottom:24rpx; }.selected-goal { margin-top:12rpx; font-size:30rpx; font-weight:700; word-break:break-all; }.stats-hero { padding:30rpx; background:#E4E9D5; border-radius:28rpx; margin-bottom:20rpx; }.stats-hero .eyebrow { color:#8A9572; }.count { font-size:106rpx; line-height:1.3; font-weight:850; letter-spacing:-4rpx; color:#4F613D; }.count text { font-size:26rpx; letter-spacing:0; color:#8F987F; font-weight:500; }.stats-hero .caption { font-size:21rpx; }.stats-hero .progress-track { background:#CCD5B8; margin-top:20rpx; height:12rpx; }.stats-hero .progress-fill { background:#7E925E; }.metrics { padding:28rpx 12rpx; }.metric-value { font-size:39rpx; }.unit { font-size:20rpx; font-weight:500; margin-left:5rpx; }.metric-label { font-size:20rpx; }.calendar { padding:24rpx; }.calendar-grid { display:grid; grid-template-columns:repeat(7,1fr); gap:12rpx 10rpx; }.calendar-cell { background:#F0F1E8; border:2rpx solid transparent; color:#9EA48D; text-align:center; border-radius:16rpx; padding:8rpx 0; font-size:25rpx; line-height:1.35; }.calendar-cell text { font-size:15rpx; display:block; margin-top:4rpx; opacity:.8; }.calendar-cell.complete { background:#849969; color:white; }.calendar-cell.future { background:#F9FAF5; color:#C3C6B9; }.calendar-cell.is-today { border-color:#D75A32; }.calendar-legend { display:flex; align-items:center; justify-content:center; font-size:17rpx; color:#9AA18A; margin-top:26rpx; }.legend-dot { display:inline-block; width:14rpx; height:14rpx; border-radius:4rpx; background:#849969; margin:0 7rpx 0 18rpx; }.pending { background:#E2E5D8; }.future-dot { background:#F8F9F2; border:2rpx solid #E6E9DC; }.insight { background:#EFECDD; padding:26rpx; border-radius:24rpx; color:#8A876D; font-size:25rpx; margin-top:24rpx; }.insight-heading { font-weight:700; color:#8C7554; margin-bottom:12rpx; }.insight .tiny { font-size:20rpx; margin-top:16rpx; color:#A29F85; }.record { margin-bottom:20rpx; padding:26rpx; }.record-date { font-size:28rpx; font-weight:650; }.record-note { font-size:25rpx; margin:20rpx 0 10rpx; white-space:pre-wrap; word-break:break-all; }.record .photos { margin-top:16rpx; }
