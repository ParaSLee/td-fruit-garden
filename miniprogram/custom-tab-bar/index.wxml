<view class="tabbar"><view wx:for="{{items}}" wx:key="path" class="tab {{selected === index ? 'active' : ''}}" data-index="{{index}}" bindtap="change" role="button" aria-label="{{item.title}}"><view class="tab-icon">{{item.icon}}</view><view class="tab-title">{{item.title}}</view><view class="dot" wx:if="{{selected === index}}"></view></view></view>
