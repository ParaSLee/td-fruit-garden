<view class="subpage"><mode-banner /><state-panel loading="{{loading}}" error="{{loadError}}" bind:retry="refresh" /><block wx:if="{{!loading && !loadError}}"><block wx:if="{{invite}}"><view class="center invite-hero"><view class="brand-mark">猛</view><view class="eyebrow">YOU'RE INVITED</view><view class="title">一起坚持，更有劲。</view><view class="caption">你的搭子，给你留了一个位置。</view></view><view class="card team-invite"><view class="badge">小队邀请</view><view class="title">{{invite.name}}</view><view class="caption">{{invite.motto}}</view><view class="divider"></view><view class="row caption"><text>已有 {{invite.memberCount}} 位行动搭子</text><text>最多 {{invite.maxMembers}} 人</text></view></view><button class="primary bottom-action" bindtap="joinTeam" loading="{{working}}" disabled="{{working || invite.memberCount >= invite.maxMembers}}">{{invite.memberCount >= invite.maxMembers ? '这个小队已满员' : '加入小队，一起说到做到 ↗'}}</button><button class="link" bindtap="goToday">我先逛逛</button></block>
<block wx:elif="{{goal}}"><view class="center share-heading"><view class="eyebrow">{{mode === 'supervise' ? 'A PROMISE NEEDS A WITNESS' : 'PROGRESS WORTH SHARING'}}</view><view class="title">{{mode === 'supervise' ? '这次，请你盯着我。' : '我的进步，请查收。'}}</view><view class="caption">{{mode === 'supervise' ? '多一个人看见，就多一点坚持的力量。' : '不和别人比，只比昨天多迈一步。'}}</view></view>
<view class="share-card"><view class="row"><view class="flex"><view class="brand-mark">猛</view><view class="share-brand">猛男打卡<view class="eyebrow">MAKE IT HAPPEN</view></view></view><text class="card-edition">{{mode === 'supervise' ? '督促邀请' : '进度分享'}}</text></view><view class="share-owner">{{owner.nickname}} 的{{goal.categoryInfo.name}}挑战</view><view class="share-goal">{{goal.title}}</view><view class="share-big">{{summary.count}}<text> / {{goal.days}} 天</text></view><view class="row caption"><text>每一次行动，都让目标近一点。</text><text>{{summary.progress}}%</text></view><view class="progress-track"><view class="progress-fill" style="width:{{summary.progress}}%"></view></view><view class="share-metrics"><view><text>{{summary.streak}}</text><view>连续坚持 / 天</view></view><view><text>{{summary.best}}</text><view>最长连续 / 天</view></view><view><text>{{summary.rate}}%</text><view>当前完成率</view></view></view><view class="share-week"><view wx:for="{{summary.week}}" wx:key="date" class="share-day {{item.done ? 'done' : ''}}">{{item.done ? '✓' : item.label}}</view></view><view class="share-card-footer">说到，就做到。 <text>SHOW UP. EVERY DAY.</text></view></view>
<block wx:if="{{composing}}"><view class="card photo-setting row" wx:if="{{!token}}"><view><view class="photo-label">附上最近打卡的图片</view><view class="tiny muted">默认关闭；感想不会被分享</view></view><switch checked="{{includePhotos}}" bindchange="togglePhotos" color="#D75A32" /></view><view wx:if="{{formError}}" class="error">{{formError}}</view><button wx:if="{{!token}}" class="primary bottom-action generate-share" bindtap="generate" loading="{{generating}}" disabled="{{generating}}">生成{{mode === 'supervise' ? '督促邀请' : '进度分享卡'}} ↗</button><block wx:else><button class="primary bottom-action" open-type="share">分享给微信好友 ↗</button><view class="share-tip">也可以点右上角“···”分享到朋友圈。<br/>链接 7 天有效，展示该目标的实时进度。{{includePhotos ? '本卡包含最近的图片凭证。' : '本卡不包含图片凭证。'}}</view><button class="link" bindtap="revoke">撤销这张分享卡</button></block><view class="field-hint center" wx:if="{{mode === 'supervise'}}">好友主动加入后，可每天在小程序里提醒你一次。</view></block>
<block wx:elif="{{!isOwner}}"><block wx:if="{{mode === 'supervise'}}"><button wx:if="{{!watching}}" class="primary bottom-action" bindtap="joinSupervision" loading="{{working}}" disabled="{{working || summary.finished}}">{{summary.finished ? '这个挑战已结束' : '我来监督你，说到做到 ↗'}}</button><button wx:else class="primary bottom-action" bindtap="nudge" loading="{{working}}" disabled="{{working || nudgedToday || summary.finished || summary.todayDone}}">{{summary.finished ? '这个挑战已结束' : nudgedToday ? '今天已提醒，明天继续' : summary.todayDone ? 'TA 今天已完成，明天继续' : '提醒 TA，今天别掉队 ↗'}}</button><view class="field-hint center">提醒出现在 TA 的小程序内，每人每天一次。<br/>加入后可在“我的”继续查看，也可以解除监督。</view></block><view wx:else class="share-tip">为朋友的坚持点个赞，下一次进步也可以是你。</view><button class="outline bottom-action" bindtap="goToday">我也来开启一个挑战</button></block><view wx:else class="share-tip">这是你分享的实时进度，好友会看到上面的内容。</view>
<view wx:if="{{includePhotos && records.length}}" class="section"><view class="section-title">最近的行动凭证</view><view wx:for="{{records}}" wx:key="date" class="card evidence" wx:if="{{item.photos.length}}"><view class="tiny muted">{{item.date}}</view><view class="photos"><image wx:for="{{item.photos}}" wx:for-item="photo" wx:key="*this" class="photo" src="{{photo}}" mode="aspectFill" data-url="{{photo}}" data-urls="{{item.photos}}" bindtap="previewPhoto" /></view></view></view></block></block></view>
