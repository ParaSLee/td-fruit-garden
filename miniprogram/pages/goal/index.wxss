.page-heading { margin:20rpx 0 16rpx; font-size:46rpx; }.field-label { margin-top:42rpx; }.categories { display:flex; }.category-item { flex:1; border:2rpx solid #E0E3D7; border-radius:26rpx; background:#FFF; margin-right:16rpx; padding:22rpx 8rpx; text-align:center; font-size:26rpx; }.category-item:last-child { margin:0; }.category-item.chosen { border:3rpx solid #D75A32; background:#FFF3E8; }.category-icon { font-size:47rpx; line-height:1.4; margin-bottom:5rpx; }.radio { height:30rpx; width:30rpx; line-height:29rpx; font-size:22rpx; border:2rpx solid #DCE0D2; border-radius:50%; margin:15rpx auto 0; color:white; }.chosen .radio { background:#D75A32; border-color:#D75A32; }.goal-input { height:160rpx; }.suggestion { color:#A56C48; font-size:21rpx; }.promise { margin-top:42rpx; display:flex; padding:26rpx; background:#EEEFDF; border-color:#E0E5D0; }.promise-icon { font-size:45rpx; color:#7C8D62; margin-right:20rpx; }.promise-title { color:#546243; font-size:27rpx; font-weight:700; margin-bottom:8rpx; }.promise .caption { font-size:22rpx; color:#8B937E; }
